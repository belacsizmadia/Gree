# A server minden hálózati interfészen figyel, így a Pi a helyi hálózatról elérhető.
GREE_HOST=0.0.0.0
GREE_PORT=8080

# Opcionális automatikus soros csatlakozás indításkor.
# GREE_SERIAL_PORT=/dev/ttyUSB0
# GREE_BAUDRATE=115200

# Opcionális: a klíma fix helyi IPv4-címe. Ezzel gyorsabb és megbízhatóbb a felderítés.
# GREE_AC_HOST=192.168.1.73

# A webes felületen mentett, névvel ellátott klímaprofilok.
GREE_CONFIG_PATH=data/climates.json

# TapHome Packet Parser gateway.
GREE_TAPHOME_CACHE_SECONDS=1
# Profilok nélküli, korábbi egyklímás beállításhoz opcionális:
# GREE_TAPHOME_DEVICE=AABBCC112233

# Hardver nélküli teszteléshez:
# GREE_DEMO=1
